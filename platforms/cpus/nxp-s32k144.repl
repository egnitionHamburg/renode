cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    IRQ -> cpu@0

// 512 KB Flash
flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00080000

// 64 KB SRAM (SRAM_L and SRAM_U combined)
sram: Memory.MappedMemory @ sysbus 0x1FFF8000
    size: 0x00010000

// Add the native NXP FlexCAN controller(s)
// Use explicit size bindings `<address, +size>` to prevent the S32K3XX model
// from claiming 0x3200 bytes and overlapping with other peripherals.
can0: CAN.NXP_FlexCAN @ sysbus <0x40024000, +0x1000>
    -> nvic@81

can1: CAN.NXP_FlexCAN @ sysbus <0x40025000, +0x1000>
    -> nvic@88

can2: CAN.NXP_FlexCAN @ sysbus <0x4002B000, +0x1000>
    -> nvic@95

portA: GPIOPort.NXPGPIOPort @ {
        sysbus new Bus.BusMultiRegistration { address: 0x400FF000; size: 0x40; region: "gpio" };
        sysbus new Bus.BusMultiRegistration { address: 0x40049000; size: 0x1000; region: "port" }
    }
    numberOfPins: 18
    -> nvic@59

portB: GPIOPort.NXPGPIOPort @ {
        sysbus new Bus.BusMultiRegistration { address: 0x400FF040; size: 0x40; region: "gpio" };
        sysbus new Bus.BusMultiRegistration { address: 0x4004A000; size: 0x1000; region: "port" }
    }
    numberOfPins: 18
    -> nvic@60

portC: GPIOPort.NXPGPIOPort @ {
        sysbus new Bus.BusMultiRegistration { address: 0x400FF080; size: 0x40; region: "gpio" };
        sysbus new Bus.BusMultiRegistration { address: 0x4004B000; size: 0x1000; region: "port" }
    }
    numberOfPins: 18
    -> nvic@61

portD: GPIOPort.NXPGPIOPort @ {
        sysbus new Bus.BusMultiRegistration { address: 0x400FF0C0; size: 0x40; region: "gpio" };
        sysbus new Bus.BusMultiRegistration { address: 0x4004C000; size: 0x1000; region: "port" }
    }
    numberOfPins: 18
    -> nvic@62

portE: GPIOPort.NXPGPIOPort @ {
        sysbus new Bus.BusMultiRegistration { address: 0x400FF100; size: 0x40; region: "gpio" };
        sysbus new Bus.BusMultiRegistration { address: 0x4004D000; size: 0x1000; region: "port" }
    }
    numberOfPins: 17
    -> nvic@63

